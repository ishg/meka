# Comma-separated list of private ICS calendar URLs for the main calendar views.
# Google Calendar: Settings → Integrate calendar → "Secret address in iCal format"
CALENDAR_ICS_URLS=

# Optional: a single ICS URL whose events power the "Coming up" panel
# (birthdays, anniversaries, etc). Excluded from the main views.
CELEBRATIONS_ICS_URL=

# Optional: BART API key for the transit panel (12th St. Oakland City Center
# departures). Falls back to BART's public demo key if unset.
# Request your own at https://api.bart.gov/api/register.aspx
BART_API_KEY=
